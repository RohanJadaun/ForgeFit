NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_URL=https://your-frontend-domain.example
API_PUBLIC_URL=https://your-backend-domain.example

# Optional: enables Google and GitHub OAuth sign-in. Register the callback URLs
# shown in README.md with each provider and keep these secrets on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: enables AI-provider replies. Without these, the personalized local coach remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional: enables password reset emails through Resend.
RESEND_API_KEY=
EMAIL_FROM=ForgeFit <no-reply@your-domain.example>
